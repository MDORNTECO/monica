rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { 
      return request.auth != null && (request.auth.token.email_verified == true || request.auth.token.email.matches('.*@agendamonica\\.com$')); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidClient(data) {
      return data.keys().hasAll(['userId', 'name', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidSale(data) {
      return data.keys().hasAll(['userId', 'clientId', 'brand', 'date', 'monthYear', 'totalValue', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.clientId is string && data.clientId.size() > 0 && data.clientId.size() <= 128 &&
             data.brand is string && data.brand.size() <= 50 &&
             data.date is string && data.date.size() <= 50 &&
             data.monthYear is string && data.monthYear.size() <= 50 &&
             data.totalValue is number && data.totalValue >= 0 &&
             data.createdAt is number && data.updatedAt is number;
    }

    function isValidInstallment(data) {
      return data.keys().hasAll(['userId', 'saleId', 'clientId', 'amount', 'dueDate', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.saleId is string && data.saleId.size() > 0 && data.saleId.size() <= 128 &&
             data.clientId is string && data.clientId.size() > 0 && data.clientId.size() <= 128 &&
             (data.amount is number || data.amount is string) &&
             data.dueDate is string && data.dueDate.size() <= 60 &&
             data.createdAt is number && data.updatedAt is number;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'saleId', 'installmentId', 'amount', 'date', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.saleId is string && data.saleId.size() > 0 && data.saleId.size() <= 128 &&
             data.installmentId is string && data.installmentId.size() > 0 && data.installmentId.size() <= 128 &&
             data.amount is number && data.amount >= 0 &&
             data.date is string && data.date.size() <= 50 &&
             data.createdAt is number && data.updatedAt is number;
    }

    // CLIENTS
    match /clients/{clientId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn() && isValidId(clientId) && isValidClient(incoming());
      allow update: if isOwner(existing().userId) && isValidClient(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);
    }

    // SALES
    match /sales/{saleId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn() && isValidId(saleId) && isValidSale(incoming());
      allow update: if isOwner(existing().userId) && isValidSale(incoming()) && incoming().userId == existing().userId && incoming().clientId == existing().clientId;
      allow delete: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);
    }

    // INSTALLMENTS
    match /installments/{installmentId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn() && isValidId(installmentId) && isValidInstallment(incoming());
      allow update: if isOwner(existing().userId) && isValidInstallment(incoming()) && incoming().userId == existing().userId && incoming().saleId == existing().saleId;
      allow delete: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);
    }

    // PAYMENTS
    match /payments/{paymentId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming());
      allow update: if isOwner(existing().userId) && isValidPayment(incoming()) && incoming().userId == existing().userId && incoming().saleId == existing().saleId;
      allow delete: if isOwner(existing().userId);
      allow list: if isOwner(resource.data.userId);
    }
  }
}
